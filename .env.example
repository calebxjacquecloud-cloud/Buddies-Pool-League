# Copy to .env for local development. In production, set these in
# Netlify → Site configuration → Environment variables (see README).

# --- Supabase (Project Settings → API) ---
# Public: safe to expose in the browser. Read-only thanks to Row Level Security.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server only (Netlify Functions). NEVER prefix with VITE_ — it would leak into the website.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# --- Host access ---
# The PIN bar staff type on the iPad. Use 6+ digits. Changing it signs every device out.
HOST_PIN=123456

# --- Public site URL (used in texted links). Netlify sets URL automatically, ---
# --- so this is only needed for a custom domain like https://pool.buddiesdenver.com ---
PUBLIC_SITE_URL=

# --- Twilio (optional — the app works without it using "Share via Messages") ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# Use ONE of these: a Messaging Service (recommended for A2P 10DLC) or a phone number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=+17205550000

# --- Demo mode (local only) ---
# When VITE_SUPABASE_URL is empty, the app runs in demo mode with data stored in
# this browser only. Demo host PIN:
VITE_DEMO_PIN=1234
